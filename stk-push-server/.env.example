# Copy this file to .env (stk-push-server/.env) and fill in real values.
# .env is git-ignored - never commit it.

PORT=3000

# HashBack API key (required)
HASHBACK_API_KEY=your_api_key_here

# HashPay ACCOUNT ID (required) - Settings > Payment Channels.
# This is NOT the Wallet ID (HW...) from the Credentials tab.
HASHBACK_ACCOUNT_ID=change_me

# HashBack "Initiate STK Push" endpoint (required). Verified against
# https://hashback.co.ke/documentation
HASHBACK_STK_ENDPOINT=https://api.hashback.co.ke/initiatestk

# Optional: set to 1 to build + log the outgoing request and send nothing.
# Keeps testing safe - no handset is ever charged while this is on.
# DRY_RUN=1

# Not read by stk-push-server/server.js. Only ../surveypesa-backend uses it
# to verify webhook signatures.
HASHBACK_WEBHOOK_SECRET=change_me

# Optional: comma-separated CORS allow-list. Leave empty to allow all origins.
CORS_ORIGIN=
