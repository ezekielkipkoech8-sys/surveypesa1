 0;\r\n            position: relative;\r\n            overflow-x: hidden;\r\n        }\r\n\r\n        body::before {\r\n            content: '';\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            right: 0;\r\n            bottom: 0;\r\n            background: \r\n                radial-gradient(circle at 20% 80%, rgba(0, 255, 127, 0.1) 0%, transparent 50%),\r\n                radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);\r\n            pointer-events: none;\r\n        }\r\n\r\n        .sparkle {\r\n            position: absolute;\r\n            width: 40px;\r\n            height: 40px;\r\n            right: 10%;\r\n            bottom: 15%;\r\n            animation: sparkleFloat 3s ease-in-out infinite;\r\n        }\r\n\r\n        @keyframes sparkleFloat {\r\n            0%, 100% { transform: translateY(0px) rotate(0deg); opacity: 0.6; }\r\n            50% { transform: translateY(-20px) rotate(180deg); opacity: 1; }\r\n        }\r\n\r\n        .container {\r\n            width: 100%;\r\n            position: relative;\r\n            z-index: 1;\r\n            padding: 0 20px;\r\n        }\r\n\r\n        .header {\r\n            text-align: center;\r\n            margin-bottom: 50px;\r\n            animation: fadeInDown 0.8s ease-out;\r\n        }\r\n\r\n        @keyframes fadeInDown {\r\n            from {\r\n                opacity: 0;\r\n                transform: translateY(-30px);\r\n            }\r\n            to {\r\n                opacity: 1;\r\n                transform: translateY(0);\r\n            }\r\n        }\r\n\r\n        .header h1 {\r\n            font-size: 3rem;\r\n            font-weight: 700;\r\n            color: #d4a574;\r\n            margin-bottom: 10px;\r\n            letter-spacing: -0.5px;\r\n            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);\r\n        }\r\n\r\n        .header p {\r\n            font-size: 1.3rem;\r\n            color: var(--cream);\r\n            font-weight: 400;\r\n        }\r\n\r\n        .tiers {\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 30px;\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .tier-card {\r\n            background: var(--cream);\r\n            border-radius: 20px;\r\n            padding: 40px 30px;\r\n            position: relative;\r\n            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\r\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);\r\n            animation: fadeInUp 0.8s ease-out backwards;\r\n        }\r\n\r\n        .tier-card:nth-child(1) {\r\n            animation-delay: 0.1s;\r\n        }\r\n\r\n        .tier-card:nth-child(2) {\r\n            animation-delay: 0.2s;\r\n            border: 3px solid var(--brown);\r\n        }\r\n\r\n        .tier-card:nth-child(3) {\r\n            animation-delay: 0.3s;\r\n        }\r\n\r\n        @keyframes fadeInUp {\r\n            from {\r\n                opacity: 0;\r\n                transform: translateY(40px);\r\n            }\r\n            to {\r\n                opacity: 1;\r\n                transform: translateY(0);\r\n            }\r\n        }\r\n\r\n        .tier-card:hover {\r\n            transform: translateY(-10px);\r\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);\r\n        }\r\n\r\n        .popular-badge {\r\n            position: absolute;\r\n            top: -15px;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            background: var(--brown);\r\n            color: var(--cream);\r\n            padding: 8px 24px;\r\n            border-radius: 20px;\r\n            font-size: 0.85rem;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n        }\r\n\r\n        .tier-price {\r\n            font-size: 3rem;\r\n            font-weight: 700;\r\n            color: var(--dark-teal);\r\n            margin-bottom: 5px;\r\n        }\r\n\r\n        .tier-name {\r\n            font-size: 1.1rem;\r\n            color: var(--brown);\r\n            font-weight: 600;\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .tier-title {\r\n            font-size: 1.8rem;\r\n            font-weight: 700;\r\n            color: var(--dark-teal);\r\n            margin-bottom: 25px;\r\n        }\r\n\r\n        .tier-card:nth-child(2) .tier-title {\r\n            margin-top: 20px;\r\n        }\r\n\r\n        .tier-features {\r\n            list-style: none;\r\n            margin-bottom: 40px;\r\n        }\r\n\r\n        .tier-features li {\r\n            color: var(--dark-teal);\r\n            font-size: 1rem;\r\n            margin-bottom: 12px;\r\n            padding-left: 25px;\r\n            position: relative;\r\n            line-height: 1.5;\r\n        }\r\n\r\n        .tier-features li::before {\r\n            content: '\u2022';\r\n            position: absolute;\r\n            left: 8px;\r\n            color: var(--main-teal);\r\n            font-size: 1.4rem;\r\n            line-height: 1.2;\r\n        }\r\n\r\n        .tier-button-link {\r\n            display: block;\r\n            text-decoration: none;\r\n            width: 100%;\r\n        }\r\n\r\n        .tier-button {\r\n            width: 100%;\r\n            padding: 16px;\r\n            border: none;\r\n            border-radius: 12px;\r\n            font-size: 1.1rem;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            transition: all 0.3s ease;\r\n            font-family: 'Outfit', sans-serif;\r\n            text-transform: capitalize;\r\n        }\r\n\r\n        .tier-card:nth-child(1) .tier-button,\r\n        .tier-card:nth-child(3) .tier-button {\r\n            background: var(--bright-green);\r\n            color: var(--dark-teal);\r\n        }\r\n\r\n        .tier-card:nth-child(2) .tier-button {\r\n            background: var(--brown);\r\n            color: var(--cream);\r\n        }\r\n\r\n        .tier-button:hover {\r\n            transform: translateY(-2px);\r\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);\r\n        }\r\n\r\n        .tier-card:nth-child(1) .tier-button:hover,\r\n        .tier-card:nth-child(3) .tier-button:hover {\r\n            background: #00e673;\r\n        }\r\n\r\n        .tier-card:nth-child(2) .tier-button:hover {\r\n            background: #4a3329;\r\n        }\r\n\r\n        .note {\r\n            text-align: center;\r\n            background: rgba(245, 241, 232, 0.95);\r\n            padding: 15px 30px;\r\n            border-radius: 12px;\r\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);\r\n            animation: fadeIn 1s ease-out 0.6s backwards;\r\n        }\r\n\r\n        @keyframes fadeIn {\r\n            from { opacity: 0; }\r\n            to { opacity: 1; }\r\n        }\r\n\r\n        .note-text {\r\n            color: #c85a54;\r\n            font-size: 1rem;\r\n            font-weight: 500;\r\n        }\r\n\r\n        @media (max-width: 1024px) {\r\n            .tiers {\r\n                grid-template-columns: 1fr;\r\n                gap: 40px;\r\n            }\r\n            \r\n            .container {\r\n                padding: 0 15px;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 768px) {\r\n            body {\r\n                padding: 30px 0;\r\n            }\r\n\r\n            .header {\r\n                margin-bottom: 40px;\r\n            }\r\n\r\n            .header h1 {\r\n                font-size: 2rem;\r\n                line-height: 1.2;\r\n            }\r\n\r\n            .header p {\r\n                font-size: 1.1rem;\r\n            }\r\n\r\n            .tier-card {\r\n                padding: 35px 25px;\r\n            }\r\n\r\n            .tier-price {\r\n                font-size: 2.5rem;\r\n            }\r\n\r\n            .tier-title {\r\n                font-size: 1.5rem;\r\n            }\r\n\r\n            .tier-button {\r\n                padding: 14px;\r\n                font-size: 1rem;\r\n            }\r\n\r\n            .note {\r\n                padding: 12px 20px;\r\n            }\r\n\r\n            .note-text {\r\n                font-size: 0.9rem;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 480px) {\r\n            .header h1 {\r\n                font-size: 1.6rem;\r\n            }\r\n\r\n            .header p {\r\n                font-size: 1rem;\r\n            }\r\n\r\n            .tier-card {\r\n                padding: 30px 20px;\r\n            }\r\n\r\n            .tier-price {\r\n                font-size: 2.2rem;\r\n            }\r\n\r\n            .tier-title {\r\n                font-size: 1.3rem;\r\n            }\r\n\r\n            .tier-features li {\r\n                font-size: 0.95rem;\r\n            }\r\n\r\n            .popular-badge {\r\n                font-size: 0.75rem;\r\n                padding: 6px 18px;\r\n            }\r\n        }\r\n    <\/style>\r\n<\/head>\r\n<body>\r\n    <svg class=\"sparkle\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n        <path d=\"M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z\" fill=\"#00ff7f\" opacity=\"0.8\"\/>\r\n        <path d=\"M18 6L18.5 8L20.5 8.5L18.5 9L18 11L17.5 9L15.5 8.5L17.5 8L18 6Z\" fill=\"#00ff7f\" opacity=\"0.6\"\/>\r\n    <\/svg>\r\n\r\n    <div class=\"container\">\r\n        <div class=\"header\">\r\n            <h1>Unlock Your Earning Potential<\/h1>\r\n            <p>Choose Your Activation Tier<\/p>\r\n        <\/div>\r\n\r\n        <div class=\"tiers\">\r\n            <!-- Lite Tier -->\r\n            <div class=\"tier-card\">\r\n                <div class=\"tier-price\">Ksh. 49<\/div>\r\n                <div class=\"tier-name\">Lite Activation<\/div>\r\n                <div class=\"tier-title\">Lite<\/div>\r\n                <ul class=\"tier-features\">\r\n                    <li>8 surveys per day<\/li>\r\n                    <li>Earn Ksh. 800 - 1,200 daily<\/li>\r\n                    <li>Access to essential surveys<\/li>\r\n                <\/ul>\r\n                <a href=\"https:\/\/surveypesa.co.ke\/pay\" class=\"tier-button-link\">\r\n                    <button class=\"tier-button\">Select Lite Tier<\/button>\r\n                <\/a>\r\n            <\/div>\r\n\r\n            <!-- Standard Tier -->\r\n            <div class=\"tier-card\">\r\n                <div class=\"popular-badge\">Most Popular<\/div>\r\n                <div class=\"tier-price\">Ksh. 99<\/div>\r\n                <div class=\"tier-name\">Activation<\/div>\r\n                <div class=\"tier-title\">Standard Activation<\/div>\r\n                <ul class=\"tier-features\">\r\n                    <li>20 surveys per day<\/li>\r\n                    <li>Earn Ksh. 2000 - 4,000 daily<\/li>\r\n                    <li>Unlock \"Pro\" surveys<\/li>\r\n                    <li>Priority support<\/li>\r\n                <\/ul>\r\n                <a href=\"https:\/\/surveypesa.co.ke\/pay-99\" class=\"tier-button-link\">\r\n                    <button class=\"tier-button\">Select Standard Tier<\/button>\r\n                <\/a>\r\n            <\/div>\r\n\r\n            <!-- Premium Tier -->\r\n            <div class=\"tier-card\">\r\n                <div class=\"tier-price\">Ksh. 149<\/div>\r\n                <div class=\"tier-name\">Activation<\/div>\r\n                <div class=\"tier-title\">Premium<\/div>\r\n                <ul class=\"tier-features\">\r\n                    <li>50 surveys per day<\/li>\r\n                    <li>Earn Ksh. 5,000 - 7,000 daily<\/li>\r\n                    <li>Full access to all surveys<\/li>\r\n                    <li>Bonus withdrawal multiplier<\/li>\r\n                <\/ul>\r\n                <a href=\"https:\/\/surveypesa.co.ke\/pay-149\" class=\"tier-button-link\">\r\n                    <button class=\"tier-button\">Select Premium Tier<\/button>\r\n                <\/a>\r\n            <\/div>\r\n        <\/div>\r\n\r\n        <div class=\"note\">\r\n            <p class=\"note-text\">Note: Activation fees are fully-refundable.<\/p>\r\n                    <h3>\ud83d\udcb8 Withdraw your earnings to M-Pesa in minutes<\/h3>\r\n            <h3>1. Instant M-Pesa withdrawals for activated users<\/h3>\r\n                  <h3>2. Most users recover activation in their first surveys<\/h3>\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <script>\r\n        \/\/ Add smooth scroll reveal animations\r\n        const observerOptions = {\r\n            threshold: 0.1,\r\n            rootMargin: '0px 0px -50px 0px'\r\n        };\r\n\r\n        const observer = new IntersectionObserver((entries) => {\r\n            entries.forEach(entry => {\r\n                if (entry.isIntersecting) {\r\n                    entry.target.style.opacity = '1';\r\n                    entry.target.style.transform = 'translateY(0)';\r\n                }\r\n            });\r\n        }, observerOptions);\r\n\r\n        \/\/ Add click animations\r\n        document.querySelectorAll('.tier-button').forEach(button => {\r\n            button.addEventListener('click', function(e) {\r\n                this.style.transform = 'scale(0.95)';\r\n                setTimeout(() => {\r\n                    this.style.transform = '';\r\n                }, 150);\r\n            });\r\n        });\r\n\r\n        \/\/ Add hover effect for touch devices\r\n        if ('ontouchstart' in window) {\r\n            document.querySelectorAll('.tier-card').forEach(card => {\r\n                card.addEventListener('touchstart', function() {\r\n                    this.style.transform = 'translateY(-5px)';\r\n                });\r\n                card.addEventListener('touchend', function() {\r\n                    this.style.transform = '';\r\n                });\r\n            });\r\n        }\r\n    <\/script>\r\n<\/body>\r\n<\/html>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-ele