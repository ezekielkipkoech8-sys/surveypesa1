white;\r\n    padding: 18px 24px 26px;\r\n  }\r\n  .topbar-inner {\r\n    max-width: 720px;\r\n    margin: 0 auto;\r\n  }\r\n  .brand {\r\n    color: var(--lime);\r\n    font-size: 22px;\r\n    font-weight: 800;\r\n    letter-spacing: -0.3px;\r\n  }\r\n  .welcome-row {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    margin-top: 4px;\r\n    color: #C9D6EC;\r\n    font-size: 15px;\r\n  }\r\n\r\n  .activation-banner {\r\n    margin-top: 16px;\r\n    background: var(--navy-light);\r\n    border: 1px solid rgba(255,255,255,0.08);\r\n    border-radius: var(--radius);\r\n    padding: 16px 18px;\r\n    display: flex;\r\n    gap: 14px;\r\n    align-items: flex-start;\r\n  }\r\n  .activation-banner .icon {\r\n    font-size: 22px;\r\n    line-height: 1;\r\n  }\r\n  .activation-banner h2 {\r\n    font-size: 15.5px;\r\n    font-weight: 700;\r\n    color: white;\r\n  }\r\n  .activation-banner p {\r\n    font-size: 13.5px;\r\n    color: #B9C6DE;\r\n    margin-top: 3px;\r\n  }\r\n\r\n  \/* ---------- MAIN ---------- *\/\r\n  main {\r\n    max-width: 720px;\r\n    margin: 0 auto;\r\n    padding: 20px 16px 0;\r\n  }\r\n\r\n  .card {\r\n    background: var(--card);\r\n    border-radius: var(--radius);\r\n    border: 1px solid var(--border);\r\n    margin-bottom: 18px;\r\n    overflow: hidden;\r\n  }\r\n\r\n  \/* Account summary card *\/\r\n  .summary-card {\r\n    background: var(--navy);\r\n    color: white;\r\n    padding: 22px;\r\n  }\r\n  .summary-top {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: flex-start;\r\n    flex-wrap: wrap;\r\n    gap: 16px;\r\n  }\r\n  .summary-label {\r\n    font-size: 13px;\r\n    color: #9FB1CE;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.06em;\r\n    font-weight: 600;\r\n  }\r\n  .summary-value {\r\n    font-size: 34px;\r\n    font-weight: 800;\r\n    color: var(--lime);\r\n    margin-top: 4px;\r\n    letter-spacing: -0.5px;\r\n  }\r\n  .status-chip {\r\n    background: rgba(168, 230, 0, 0.15);\r\n    color: var(--lime);\r\n    font-size: 12.5px;\r\n    font-weight: 700;\r\n    padding: 6px 12px;\r\n    border-radius: 999px;\r\n    border: 1px solid rgba(168,230,0,0.35);\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .threshold-block {\r\n    margin-top: 20px;\r\n  }\r\n  .threshold-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 13px;\r\n    color: #C9D6EC;\r\n    margin-bottom: 8px;\r\n  }\r\n  .threshold-row strong { color: white; }\r\n  .progress-track {\r\n    height: 10px;\r\n    background: rgba(255,255,255,0.12);\r\n    border-radius: 999px;\r\n    overflow: hidden;\r\n  }\r\n  .progress-fill {\r\n    height: 100%;\r\n    background: var(--lime);\r\n    border-radius: 999px;\r\n    width: 30%;\r\n  }\r\n  .threshold-note {\r\n    font-size: 12.5px;\r\n    color: #8FA3C4;\r\n    margin-top: 8px;\r\n  }\r\n\r\n  .summary-actions {\r\n    display: flex;\r\n    gap: 10px;\r\n    margin-top: 20px;\r\n    flex-wrap: wrap;\r\n  }\r\n  .btn {\r\n    flex: 1;\r\n    min-width: 140px;\r\n    padding: 13px 16px;\r\n    border-radius: 10px;\r\n    font-weight: 700;\r\n    font-size: 14.5px;\r\n    text-align: center;\r\n    border: none;\r\n    cursor: pointer;\r\n  }\r\n  .btn-primary {\r\n    background: var(--lime);\r\n    color: var(--navy-deep);\r\n  }\r\n  .btn-secondary {\r\n    background: rgba(255,255,255,0.1);\r\n    color: white;\r\n    border: 1px solid rgba(255,255,255,0.18);\r\n  }\r\n  .btn:disabled {\r\n    opacity: 0.5;\r\n    cursor: not-allowed;\r\n  }\r\n\r\n  \/* Section headers *\/\r\n  .section-head {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: baseline;\r\n    margin: 28px 4px 12px;\r\n  }\r\n  .section-head h3 {\r\n    font-size: 16.5px;\r\n    font-weight: 800;\r\n  }\r\n  .section-sub {\r\n    font-size: 12.5px;\r\n    color: var(--text-mute);\r\n    margin: -8px 4px 14px;\r\n  }\r\n\r\n  \/* Available surveys (open queue) *\/\r\n  .survey-card {\r\n    padding: 18px;\r\n  }\r\n  .survey-top {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    gap: 12px;\r\n  }\r\n  .survey-icon {\r\n    width: 42px;\r\n    height: 42px;\r\n    border-radius: 10px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    font-size: 20px;\r\n    flex-shrink: 0;\r\n  }\r\n  .survey-title-block { flex: 1; }\r\n  .survey-title {\r\n    font-size: 15.5px;\r\n    font-weight: 700;\r\n  }\r\n  .survey-org {\r\n    font-size: 12.5px;\r\n    color: var(--green);\r\n    font-weight: 600;\r\n    margin-top: 1px;\r\n  }\r\n  .survey-reward {\r\n    background: var(--green-soft);\r\n    color: var(--green);\r\n    font-weight: 800;\r\n    font-size: 13.5px;\r\n    padding: 6px 11px;\r\n    border-radius: 999px;\r\n    white-space: nowrap;\r\n    height: fit-content;\r\n  }\r\n  .survey-desc {\r\n    font-size: 13.5px;\r\n    color: var(--text-mute);\r\n    margin: 10px 0 12px;\r\n  }\r\n  .tag-row {\r\n    display: flex;\r\n    gap: 6px;\r\n    flex-wrap: wrap;\r\n    margin-bottom: 14px;\r\n  }\r\n  .tag {\r\n    background: var(--bg);\r\n    border: 1px solid var(--border);\r\n    font-size: 12px;\r\n    color: var(--text-mute);\r\n    padding: 4px 9px;\r\n    border-radius: 999px;\r\n  }\r\n\r\n  .queue-meter {\r\n    background: var(--bg);\r\n    border-radius: 10px;\r\n    padding: 11px 13px;\r\n    margin-bottom: 14px;\r\n  }\r\n  .queue-meter-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 12.5px;\r\n    color: var(--text-mute);\r\n    margin-bottom: 7px;\r\n  }\r\n  .queue-meter-row strong { color: var(--text); }\r\n  .queue-bar-track {\r\n    height: 6px;\r\n    background: var(--border);\r\n    border-radius: 999px;\r\n    overflow: hidden;\r\n  }\r\n  .queue-bar-fill {\r\n    height: 100%;\r\n    background: var(--navy);\r\n    border-radius: 999px;\r\n  }\r\n\r\n  .survey-btn {\r\n    width: 100%;\r\n    padding: 13px;\r\n    border-radius: 10px;\r\n    background: var(--lime);\r\n    color: var(--navy-deep);\r\n    font-weight: 700;\r\n    font-size: 14.5px;\r\n    border: none;\r\n    cursor: pointer;\r\n  }\r\n  .survey-btn.applied {\r\n    background: var(--bg);\r\n    color: var(--text-mute);\r\n    border: 1px solid var(--border);\r\n  }\r\n\r\n  \/* Upcoming surveys (locked, with real unlock date) *\/\r\n  .upcoming-card {\r\n    padding: 18px;\r\n    border-style: dashed;\r\n  }\r\n  .upcoming-top {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    gap: 12px;\r\n    align-items: flex-start;\r\n  }\r\n  .lock-badge {\r\n    background: #FFF4DD;\r\n    color: #9A6B00;\r\n    font-size: 11.5px;\r\n    font-weight: 700;\r\n    padding: 5px 9px;\r\n    border-radius: 999px;\r\n    white-space: nowrap;\r\n  }\r\n  .unlock-info {\r\n    background: var(--bg);\r\n    border-radius: 10px;\r\n    padding: 12px 13px;\r\n    margin: 12px 0 14px;\r\n    font-size: 13px;\r\n    color: var(--text-mute);\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    flex-wrap: wrap;\r\n    gap: 8px;\r\n  }\r\n  .unlock-info strong {\r\n    color: var(--text);\r\n    display: block;\r\n    font-size: 13.5px;\r\n  }\r\n  .notify-btn {\r\n    width: 100%;\r\n    padding: 12px;\r\n    border-radius: 10px;\r\n    background: white;\r\n    color: var(--navy);\r\n    font-weight: 700;\r\n    font-size: 14px;\r\n    border: 1.5px solid var(--navy);\r\n    cursor: pointer;\r\n  }\r\n  .notify-btn.notified {\r\n    background: var(--green-soft);\r\n    color: var(--green);\r\n    border-color: var(--green);\r\n    cursor: default;\r\n  }\r\n\r\n  \/* Payout history *\/\r\n  .payout-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    padding: 14px 18px;\r\n    border-bottom: 1px solid var(--border);\r\n  }\r\n  .payout-row:last-child { border-bottom: none; }\r\n  .payout-left { display: flex; gap: 12px; align-items: center; }\r\n  .payout-dot {\r\n    width: 8px; height: 8px;\r\n    border-radius: 50%;\r\n    background: var(--green);\r\n    flex-shrink: 0;\r\n  }\r\n  .payout-id { font-size: 13.5px; font-weight: 600; }\r\n  .payout-date { font-size: 12px; color: var(--text-mute); }\r\n  .payout-amount { font-weight: 700; font-size: 14px; }\r\n  .payout-status {\r\n    font-size: 11px;\r\n    color: var(--green);\r\n    font-weight: 700;\r\n    text-align: right;\r\n    display: block;\r\n  }\r\n\r\n  .terms-card {\r\n    padding: 18px;\r\n    font-size: 13px;\r\n    color: var(--text-mute);\r\n  }\r\n  .terms-card h4 {\r\n    color: var(--text);\r\n    font-size: 14.5px;\r\n    font-weight: 700;\r\n    margin-bottom: 8px;\r\n  }\r\n  .terms-card ul {\r\n    padding-left: 18px;\r\n  }\r\n  .terms-card li { margin-bottom: 6px; }\r\n\r\n  \/* Bottom nav *\/\r\n  .bottomnav {\r\n    position: fixed;\r\n    bottom: 0; left: 0; right: 0;\r\n    background: white;\r\n    border-top: 1px solid var(--border);\r\n    display: flex;\r\n    justify-content: space-around;\r\n    padding: 10px 0 8px;\r\n  }\r\n  .nav-item {\r\n    text-align: center;\r\n    font-size: 11.5px;\r\n    color: var(--text-mute);\r\n    font-weight: 600;\r\n  }\r\n  .nav-item.active { color: var(--green); }\r\n  .nav-icon { font-size: 19px; display: block; margin-bottom: 2px; }\r\n\r\n  @media (max-width: 480px) {\r\n    .summary-value { font-size: 28px; }\r\n  }\r\n\r\n  .panel[hidden] { display: none; }\r\n<\/style>\r\n<\/head>\r\n<body>\r\n\r\n<header class=\"topbar\">\r\n  <div class=\"topbar-inner\">\r\n    <div class=\"brand\">Survey Pesa<\/div>\r\n    <div class=\"welcome-row\">\ud83d\udc4b Welcome back<\/div>\r\n\r\n    <div class=\"activation-banner\" id=\"activation-banner\">\r\n      <div class=\"icon\">\u2705<\/div>\r\n      <div>\r\n        <h2>Your account is active \u2014 thank you<\/h2>\r\n        <p>You can now apply to surveys and request payouts once you reach the KSh 500 minimum. No further action needed.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n<\/header>\r\n\r\n<main>\r\n\r\n<section id=\"panel-home\" class=\"panel\">\r\n\r\n  <!-- ACCOUNT SUMMARY -->\r\n  <section class=\"card summary-card\">\r\n    <div class=\"summary-top\">\r\n      <div>\r\n        <div class=\"summary-label\">Earned balance<\/div>\r\n        <div class=\"summary-value\">KSh 150<\/div>\r\n      <\/div>\r\n      <div class=\"status-chip\">Active since today<\/div>\r\n    <\/div>\r\n\r\n    <div class=\"threshold-block\">\r\n      <div class=\"threshold-row\">\r\n        <span>Progress to payout minimum<\/span>\r\n        <strong>KSh 150 \/ KSh 500<\/strong>\r\n      <\/div>\r\n      <div class=\"progress-track\">\r\n        <div class=\"progress-fill\" style=\"width:30%\"><\/div>\r\n      <\/div>\r\n      <div class=\"threshold-note\">\r\n        M-Pesa payouts are released once your balance reaches KSh 500. This is a fixed platform rule, not a countdown \u2014 there's no time limit on your current balance.\r\n      <\/div>\r\n    <\/div>\r\n\r\n    <div class=\"summary-actions\">\r\n      <button class=\"btn btn-secondary\" disabled>Withdraw at KSh 500<\/button>\r\n      <button class=\"btn btn-primary\" onclick=\"goToPanel('browse')\">Find surveys<\/button>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- AVAILABLE SURVEYS (preview) -->\r\n  <div class=\"section-head\" id=\"available-surveys\">\r\n    <h3>\ud83d\udccb Open for applications<\/h3>\r\n    <a href=\"javascript:void(0)\" onclick=\"goToPanel('browse')\" style=\"font-size:13px; color:var(--green); font-weight:700;\">See all \u2192<\/a>\r\n  <\/div>\r\n  <p class=\"section-sub\">These surveys are accepting applicants now. Each one has a fixed number of spots \u2014 once filled, the survey closes to new applicants.<\/p>\r\n\r\n  <div class=\"card survey-card\">\r\n    <div class=\"survey-top\">\r\n      <div style=\"display:flex; gap:12px;\">\r\n        <div class=\"survey-icon\" style=\"background:#E8F5E9;\">\ud83c\udf7d\ufe0f<\/div>\r\n        <div class=\"survey-title-block\">\r\n          <div class=\"survey-title\">Food Preferences & Eating Habits<\/div>\r\n          <div class=\"survey-org\">Kenya Food Research<\/div>\r\n        <\/div>\r\n      <\/div>\r\n      <div class=\"survey-reward\">KSh 120<\/div>\r\n    <\/div>\r\n    <p class=\"survey-desc\">Share your food preferences and eating habits. Roughly 4 minutes.<\/p>\r\n    <div class=\"tag-row\">\r\n      <span class=\"tag\">Lifestyle<\/span><span class=\"tag\">Easy<\/span><span class=\"tag\">4 min<\/span>\r\n    <\/div>\r\n    <div class=\"queue-meter\">\r\n      <div class=\"queue-meter-row\">\r\n        <span>Spots filled<\/span>\r\n        <strong>34 of 60 applicants<\/strong>\r\n      <\/div>\r\n      <div class=\"queue-bar-track\">\r\n        <div class=\"queue-bar-fill\" style=\"width:57%\"><\/div>\r\n      <\/div>\r\n    <\/div>\r\n    <button class=\"survey-btn\" onclick=\"applyToSurvey(this)\">Apply now<\/button>\r\n  <\/div>\r\n\r\n  <div class=\"card survey-card\">\r\n    <div class=\"survey-top\">\r\n      <div style=\"display:flex; gap:12px;\">\r\n        <div class=\"survey-icon\" style=\"background:#E3F2FD;\">\ud83d\udcac<\/div>\r\n        <div class=\"survey-title-block\">\r\n          <div class=\"survey-title\">Communication & Social Habits<\/div>\r\n          <div class=\"survey-org\">Kenya Communication Research<\/div>\r\n        <\/div>\r\n      <\/div>\r\n      <div class=\"survey-reward\">KSh 95<\/div>\r\n    <\/div>\r\n    <p class=\"survey-desc\">Tell us about how you communicate and socialize. Roughly 3 minutes.<\/p>\r\n    <div class=\"tag-row\">\r\n      <span class=\"tag\">Social<\/span><span class=\"tag\">Easy<\/span><span class=\"tag\">3 min<\/span>\r\n    <\/div>\r\n    <div class=\"queue-meter\">\r\n      <div class=\"queue-meter-row\">\r\n        <span>Spots filled<\/span>\r\n        <strong>58 of 60 applicants<\/strong>\r\n      <\/div>\r\n      <div class=\"queue-bar-track\">\r